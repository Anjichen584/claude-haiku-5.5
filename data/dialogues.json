            {
              "text": "毛皮的事情，我自有办法。",
              "next": "c2",
              "effects": {
                "setFlags": [
                  "trader_proud"
                ]
              }
            }
          ]
        },
        "n4": {
          "speaker": "毛皮商 奥莉",
          "text": "如果你带回完整的皮，我会多付一笔钱。",
          "next": "n5"
        },
        "n5": {
          "speaker": "毛皮商 奥莉",
          "text": "去吧，我这儿的火炉一直为你留着。",
          "next": null
        },
        "c1": {
          "speaker": "毛皮商 奥莉",
          "text": "好，那我就等你的完整皮毛。",
          "next": "n4"
        },
        "c2": {
          "speaker": "毛皮商 奥莉",
          "text": "有办法最好，别让我失望。",
          "next": "n4"
        }
      }
    },
    {
      "id": "side_32_warden_remains",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "守望兵 维克",
          "text": "冰封守卫在湖边守了三百年，今天却突然动了。",
          "next": "n2"
        },
        "n2": {
          "speaker": "守望兵 维克",
          "text": "它的核心裂开了，露出的光和霜原哨站的蓝光一模一样。",
          "next": "n3"
        },
        "n3": {
          "speaker": "守望兵 维克",
          "text": "如果你要去，记得带上足够的火把。",
          "next": "n4"
        },
        "n4": {
          "speaker": "守望兵 维克",
          "text": "回来以后告诉我，它到底在守护什么。",
          "next": null
        }
      }
    },
    {
      "id": "side_34_ember_nest",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "猎人 托尔",
          "text": "余烬猎犬的巢穴就在山谷深处，每一窝都有一只领头的。",
          "next": "n2"
        },
        "n2": {

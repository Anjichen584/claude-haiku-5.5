          "text": "无论你做了什么，这片大陆都会记住你的名字。",
          "next": "n3"
        },
        "n3": {
          "speaker": "莉拉 与 伊瑟",
          "text": "谢谢你，编年史的最后一页，由你来写。",
          "next": "n4"
        },
        "n4": {
          "speaker": "莉拉 与 伊瑟",
          "text": "去吧，路上小心。",
          "next": null
        }
      }
    },
    {
      "id": "side_31_frost_pelt_trader",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "毛皮商 奥莉",

    {
      "id": "side_40_thorn_grove_keeper",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "林守 艾薇",
          "text": "荆棘精灵是这片林子的记忆，它们守着被遗忘的小路。",
          "next": "n2"
        },
        "n2": {
          "speaker": "林守 艾薇",
          "text": "最近它们变得躁动，因为有人在林子深处砍伐了一棵老树。",
          "choices": [
            {
              "text": "我会找到伐木者。",
              "next": "c1",
              "effects": {
                "setFlags": [
                  "grove_hunt"
                ]
              }
            },
            {
              "text": "我只拿我需要的东西。",
              "next": "c2",
              "effects": {
                "setFlags": [
                  "grove_take"
                ]
              }
            }
          ]

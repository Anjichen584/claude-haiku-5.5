        "c1": {
          "speaker": "林守 艾薇",
          "text": "那就请你小心，伐木者不会轻易认错。",
          "next": "n3"
        },
        "c2": {
          "speaker": "林守 艾薇",
          "text": "好，只拿需要的，林子会记住你的分寸。",
          "next": "n3"
        }
      }
    },
    {
      "id": "side_42_owl_watch",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "守望兵 凯",
          "text": "空洞猫头鹰整夜盘旋在哨站上空，它们不叫，只是看。",
